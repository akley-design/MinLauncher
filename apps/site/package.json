{
  "name": "@minlaucher/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/copy-public-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node server.mjs",
    "test": "vitest run src && node --test server.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.99.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@minlauncher/visuals": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
