{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MinLauncher",
  "version": "0.1.0",
  "identifier": "com.minlaucher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../apps/ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MinLauncher",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/MinLauncher/**",
            "$APPLOCALDATA/MinLauncher/**"
          ],
          "deny": [
            "$APPDATA/MinLauncher/secrets.json",
            "$APPDATA/MinLauncher/*.db",
            "$APPDATA/MinLauncher/*.db-wal",
            "$APPDATA/MinLauncher/*.db-shm"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Fast Minecraft launcher",
    "longDescription": "MinLauncher — a fast Minecraft launcher with an optimized Rust core and an in-game optimization stack."
  }
}
